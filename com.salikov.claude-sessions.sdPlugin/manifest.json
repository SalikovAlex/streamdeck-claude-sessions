	"Icon": "imgs/plugin/icon",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Profiles": [
		{
			"Name": "Claude Sessions",
			"DeviceType": 7,
			"Readonly": false,
			"AutoInstall": true
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"UUID": "com.salikov.claude-sessions"
}