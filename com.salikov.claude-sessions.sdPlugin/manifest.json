{
	"Name": "Claude Sessions",
	"Version": "0.2.2.0",
	"Author": "Alexander Salikov",
	"Actions": [
		{
			"Name": "Agent Session",
			"UUID": "com.salikov.claude-sessions.slot",
			"Icon": "imgs/actions/session/icon",
